' Uncomment the two lines below if the sensor is an LSM303AGR (otherwise, an LSM303DLHC is assumed)
'#define LSM303AGR
'#pragma exportdef(LSM303AGR)

CON

    _clkfreq    = cfg._clkfreq_def
    _xtlfreq    = cfg._xtlfreq


OBJ

    cfg:    "boardcfg.p2eval"
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    sensor: "sensor.imu.6dof.lsm303dlhc" | SCL=0, SDA=1, I2C_FREQ=400_000


PUB setup()

    ser.start()
    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"LSM303 driver started")
    else
        ser.strln(@"LSM303 driver failed to start - halting")
        repeat

    sensor.preset_active()

    repeat
        ser.pos_xy(0, 3)
        show_accel_data()
        show_mag_data()
        if ( ser.getchar_noblock() == "c" )
            cal_accel()
            cal_mag()

#include "acceldemo.common.spin2h"
#include "magdemo.common.spin2h"


DAT
